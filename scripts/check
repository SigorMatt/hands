#!/usr/bin/env bash
# The gate: ruff + pytest + a CLI smoke test. Non-zero on any failure.
# Works from a clean checkout: `uv sync` creates .venv and installs the dev extra.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

uv sync --extra dev --quiet

echo "== ruff =="
uv run ruff check .

echo "== pytest =="
uv run pytest

echo "== cli smoke =="
uv run hands --help >/dev/null

echo "check: green"
