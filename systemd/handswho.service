# handswho — the `hands who` picture, pushed to your phone (DESIGN §4, §24).
#
# Optional, and off unless you enable it. A *user* unit, like handsd: it reads
# /proc and your ~/.claude transcripts as you. It needs `[notify] who_topic` in
# ~/.hands/<project>.toml (and, for `status`/`who`/`check`/`?` from the phone,
# `who_cmd_topic`); without who_topic it exits 1 and says so.
#
#   install -Dm644 systemd/handswho.service ~/.config/systemd/user/handswho.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now handswho
#   journalctl --user -u handswho -f
#
# The project comes from the same environment file handsd reads
# (~/.config/hands.env, `HANDS_PROJECT=<project>`). ExecStart is an absolute
# path for the reason handsd.service gives: a user unit has no login shell.
# It runs with handsd down too — the picture then says the daemon is not answering.

[Unit]
Description=handswho — push the hands who picture on change (project from %h/.config/hands.env)
Documentation=https://github.com/SigorMatt/hands
After=network-online.target handsd.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hands.env
ExecStart=%h/.local/bin/handswho --project ${HANDS_PROJECT}
Restart=on-failure
RestartSec=30
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=handswho

[Install]
WantedBy=default.target
